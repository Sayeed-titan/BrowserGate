<Window x:Class="BrowserGate.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrowserGate Setup" Height="800" Width="540"
        Icon="pack://application:,,,/BrowserGate.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource UiFont}">
    <Border Background="{DynamicResource BgWin}" CornerRadius="14" Margin="18"
            BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" Opacity="0.55" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgTitlebar}"
                    BorderBrush="{DynamicResource BorderSub}" BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0">
                <Grid MouseLeftButtonDown="Drag">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Foreground="{DynamicResource FgHeading}" FontWeight="Bold" FontSize="11" Text="Browser"/>
                        <TextBlock Foreground="{DynamicResource FgMuted}" FontWeight="Bold" FontSize="11" Text="Gate"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Margin="0,0,7,0" VerticalAlignment="Center"
                            Style="{StaticResource WinCloseBtn}" Click="Close_Click">
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,22,28,26">
                <StackPanel>
                    <!-- Brand header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Width="50" Height="50" CornerRadius="14"
                                Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path Stretch="Uniform" Width="26" Height="26"
                                  Stroke="{DynamicResource Accent}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 5,12 L 23,12 L 23,25 L 5,25 Z M 8.5,12 L 8.5,8 A 5.5,5.5 0 0 1 19.5,8 L 19.5,12"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="400">
                            <TextBlock Text="Set up BrowserGate" Style="{StaticResource HTitleSm}"/>
                            <TextBlock Style="{StaticResource HSub}" Margin="0,4,0,0"
                                       Text="Lock your browser behind one master password. Your PC stays open for coworkers — your tabs stay private."/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Master password -->
                    <TextBlock Text="MASTER PASSWORD" Style="{StaticResource Lbl}" Margin="0,0,0,9"/>
                    <PasswordBox x:Name="PwdBox" Margin="0,0,0,9"/>
                    <PasswordBox x:Name="PwdBox2" Margin="0,0,0,18"/>

                    <!-- Recovery -->
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="RECOVERY" Style="{StaticResource Lbl}"/>
                        <Border Grid.Column="1" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}"
                                BorderThickness="1" CornerRadius="999" Padding="8,2">
                            <TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}"/>
                        </Border>
                    </Grid>
                    <TextBox x:Name="GmailBox" Margin="0,0,0,9">
                        <TextBox.Resources>
                            <VisualBrush x:Key="ph" AlignmentX="Left" AlignmentY="Center" Stretch="None"/>
                        </TextBox.Resources>
                    </TextBox>
                    <PasswordBox x:Name="AppPwdBox" Margin="0,0,0,6"/>
                    <TextBlock Margin="0,0,0,18" FontSize="11.5" Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap">
                        Generate an App Password at
                        <Hyperlink Foreground="{DynamicResource Accent}" NavigateUri="https://myaccount.google.com/apppasswords" RequestNavigate="OpenLink">myaccount.google.com/apppasswords</Hyperlink>
                        — BrowserGate uses it to email you a reset code if you forget the master password.
                    </TextBlock>

                    <!-- What to lock -->
                    <TextBlock Text="WHAT TO LOCK" Style="{StaticResource Lbl}" Margin="0,0,0,9"/>
                    <Border CornerRadius="10" Padding="12" Margin="0,0,0,9"
                            Background="{DynamicResource BgElev}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Background="{DynamicResource EdgeBg}">
                                <Path Stretch="Uniform" Width="18" Height="18" Stroke="{DynamicResource EdgeFg}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 12,3 A 9,9 0 1,1 3.5,15 C 7,16 11,15 14,12 C 17,9 18,5 17,2 A 9,9 0 0,1 12,3 Z"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="Microsoft Edge" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource FgHeading}"/>
                                <TextBlock Text="Lock every Edge window" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource FgMuted}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" x:Name="LockEdgeChk" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border CornerRadius="10" Padding="12" Margin="0,0,0,18"
                            Background="{DynamicResource BgElev}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Background="{DynamicResource ChromeBg}">
                                <Grid Width="18" Height="18">
                                    <Ellipse Stroke="{DynamicResource ChromeFg}" StrokeThickness="2"/>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource ChromeFg}"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="Google Chrome" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource FgHeading}"/>
                                <TextBlock Text="Lock every Chrome window" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource FgMuted}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" x:Name="LockChromeChk" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Auto re-lock -->
                    <TextBlock Text="AUTO RE-LOCK" Style="{StaticResource Lbl}" Margin="0,0,0,9"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Re-lock browsers after a period of inactivity"
                                   VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource FgBody}"/>
                        <Border Grid.Column="1" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5"
                                CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−" Style="{StaticResource StepperBtn}" Click="RelockDown_Click"/>
                                <TextBlock x:Name="RelockVal" Text="5" VerticalAlignment="Center"
                                           MinWidth="52" TextAlignment="Center" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource FgHeading}"/>
                                <TextBlock Text="min" VerticalAlignment="Center" Margin="0,0,13,0"
                                           FontSize="11" Foreground="{DynamicResource FgFaint}"/>
                                <Button Content="+" Style="{StaticResource StepperBtn}" Click="RelockUp_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="ErrorTxt" Foreground="{DynamicResource Danger}" Margin="0,0,0,10" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"/>

                    <Button Content="Save and Lock Browsers" Style="{StaticResource BtnPrimary}"
                            Padding="16,14" FontSize="14" Click="Save_Click" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
