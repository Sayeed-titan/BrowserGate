<Window x:Class="BrowserGate.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrowserGate Setup" Height="780" Width="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource UiFont}">
    <Border Background="{StaticResource Card}" CornerRadius="14" Margin="18"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" Opacity="0.55" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Height="40" MouseLeftButtonDown="Drag">
                <TextBlock Text="BrowserGate" Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button HorizontalAlignment="Right" Width="40" Height="40" Background="Transparent"
                        BorderThickness="0" Foreground="{StaticResource Muted}" Click="Close_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="Transparent" CornerRadius="0,14,0,0">
                                <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{StaticResource Muted}" StrokeThickness="1.4"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#EF4444"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,4,36,28">
                <StackPanel>
                    <!-- Header -->
                    <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource Accent}"
                            HorizontalAlignment="Left" Margin="0,0,0,16">
                        <Path Data="M 16,22 L 16,16 A 8,8 0 0 1 32,16 L 32,22 M 12,22 L 36,22 L 36,40 L 12,40 Z"
                              Stroke="White" StrokeThickness="2.5" Fill="Transparent"
                              Stretch="Uniform" Width="28" Height="28"/>
                    </Border>
                    <TextBlock Text="Welcome to BrowserGate" Style="{StaticResource H1}"/>
                    <TextBlock Text="Lock Microsoft Edge behind a master password â€” your sessions stay logged in."
                               Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,28"/>

                    <!-- Password -->
                    <TextBlock Text="MASTER PASSWORD" Style="{StaticResource Label}"/>
                    <PasswordBox x:Name="PwdBox" Margin="0,0,0,14"/>

                    <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource Label}"/>
                    <PasswordBox x:Name="PwdBox2" Margin="0,0,0,28"/>

                    <!-- Recovery -->
                    <TextBlock Text="Recovery" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Subtle}" Margin="0,0,0,12">
                        <Run Text="If you forget your password, we email a 6-digit code to your Gmail."/>
                        <LineBreak/>
                        <Run Text="Generate a Gmail App Password at "/>
                        <Hyperlink NavigateUri="https://myaccount.google.com/apppasswords" RequestNavigate="OpenLink" Foreground="#A5B4FC">
                            myaccount.google.com/apppasswords
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Text="GMAIL ADDRESS" Style="{StaticResource Label}"/>
                    <TextBox x:Name="GmailBox" Margin="0,0,0,14"/>

                    <TextBlock Text="GMAIL APP PASSWORD (16 CHARS)" Style="{StaticResource Label}"/>
                    <PasswordBox x:Name="AppPwdBox" Margin="0,0,0,28"/>

                    <!-- Options -->
                    <TextBlock Text="What to lock" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="LockEdgeChk" IsChecked="True" Margin="0,0,0,10">
                        <TextBlock Text="Microsoft Edge"/>
                    </CheckBox>
                    <CheckBox x:Name="LockChromeChk" Margin="0,0,0,20">
                        <TextBlock Text="Google Chrome"/>
                    </CheckBox>

                    <TextBlock Text="AUTO-RELOCK AFTER (MINUTES)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="RelockBox" Text="5" Margin="0,0,0,4" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Text="Closes browser N minutes after you stop using it, so reopen needs the password."
                               Style="{StaticResource Subtle}" Margin="0,0,0,28"/>

                    <TextBlock x:Name="ErrorTxt" Foreground="{StaticResource Danger}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Close_Click"/>
                        <Button Content="Save and Lock Browsers" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
