<Window x:Class="BrowserGate.Views.ResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password" Height="540" Width="440"
        Icon="pack://application:,,,/BrowserGate.ico"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource UiFont}">
    <Border Background="{DynamicResource BgWin}" CornerRadius="14" Margin="18"
            BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" Opacity="0.6" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgTitlebar}"
                    BorderBrush="{DynamicResource BorderSub}" BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0">
                <Grid MouseLeftButtonDown="Drag">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Foreground="{DynamicResource FgHeading}" FontWeight="Bold" FontSize="11" Text="Browser"/>
                        <TextBlock Foreground="{DynamicResource FgMuted}" FontWeight="Bold" FontSize="11" Text="Gate · Reset"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Margin="0,0,7,0" VerticalAlignment="Center"
                            Style="{StaticResource WinCloseBtn}" Click="Cancel_Click">
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="28,20,28,22">
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="46" Height="46" CornerRadius="13"
                            Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1">
                        <Path Stretch="Uniform" Width="22" Height="22" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 14,8 L 21,15 M 17,11 L 21,7 L 17,3 L 13,7 M 13,7 L 7,13 A 3,3 0 0,0 7,17 L 9,19 A 3,3 0 0,0 13,19 L 19,13"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="13,0,0,0">
                        <TextBlock Text="Reset your password" Style="{StaticResource HTitleSm}"/>
                        <TextBlock Style="{StaticResource HSub}" Margin="0,4,0,0"
                                   Text="We'll email a 6-digit code to your recovery Gmail."/>
                    </StackPanel>
                </StackPanel>

                <!-- Step indicator -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border x:Name="Step1Num" Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                            <TextBlock x:Name="Step1Txt" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"/>
                        </Border>
                        <TextBlock x:Name="Step1Label" Text="Send code" VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FgHeading}"/>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Height="1.5" Fill="{DynamicResource Border}" VerticalAlignment="Center" Margin="10,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Border x:Name="Step2Num" Width="22" Height="22" CornerRadius="11"
                                Background="Transparent" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1.5">
                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FgFaint}"/>
                        </Border>
                        <TextBlock x:Name="Step2Label" Text="New password" VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FgFaint}"/>
                    </StackPanel>
                </Grid>

                <!-- ═══ Step 1 ═══ -->
                <StackPanel x:Name="Step1Panel">
                    <Border CornerRadius="10" Padding="11,11"
                            Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Path Stretch="Uniform" Width="16" Height="16" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Top"
                                  Margin="0,2,0,0"
                                  Data="M 3,7 L 12,13 L 21,7 M 3,7 V 17 A 2,2 0 0,0 5,19 H 19 A 2,2 0 0,0 21,17 V 7 A 2,2 0 0,0 19,5 H 5 A 2,2 0 0,0 3,7 Z"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock FontSize="12" Foreground="{DynamicResource FgBody}" Text="A reset code will be sent to"/>
                                <TextBlock x:Name="MaskedEmailTxt" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" Foreground="{DynamicResource FgHeading}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,12,0,18" FontSize="12" Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap"
                               Text="Not your address? You can change recovery details in Settings once you're back in."/>

                    <Button x:Name="SendBtn" Content="Send code to Gmail" Style="{StaticResource BtnPrimary}"
                            Padding="16,13" FontSize="14" Click="Send_Click" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- ═══ Step 2 ═══ -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock Text="ENTER THE 6-DIGIT CODE" Style="{StaticResource Lbl}" Margin="0,0,0,9"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"  x:Name="Otp0" Style="{StaticResource OtpCell}"/>
                        <TextBox Grid.Column="2"  x:Name="Otp1" Style="{StaticResource OtpCell}"/>
                        <TextBox Grid.Column="4"  x:Name="Otp2" Style="{StaticResource OtpCell}"/>
                        <TextBox Grid.Column="6"  x:Name="Otp3" Style="{StaticResource OtpCell}"/>
                        <TextBox Grid.Column="8"  x:Name="Otp4" Style="{StaticResource OtpCell}"/>
                        <TextBox Grid.Column="10" x:Name="Otp5" Style="{StaticResource OtpCell}"/>
                    </Grid>
                    <TextBlock Margin="0,0,0,16" FontSize="11.5" Foreground="{DynamicResource FgMuted}">
                        Code sent ·
                        <Hyperlink Foreground="{DynamicResource Accent}" Click="Resend_Click">
                            <Run Text="Resend"/>
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Text="NEW MASTER PASSWORD" Style="{StaticResource Lbl}" Margin="0,0,0,9"/>
                    <PasswordBox x:Name="NewPwd" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource BtnOutline}" Click="Back_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 14,5 L 7,12 L 14,19 M 7,12 H 21"/>
                                <TextBlock Text="Back" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Click="Confirm_Click" Padding="16,12" FontSize="13.5">
                            Set new password
                        </Button>
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="ErrorTxt" Foreground="{DynamicResource Danger}"
                           FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
