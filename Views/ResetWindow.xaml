<Window x:Class="EdgeLocker.Views.ResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password" Height="500" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource UiFont}">
    <Border Background="{StaticResource Card}" CornerRadius="14" Margin="18"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" Opacity="0.6" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="36" MouseLeftButtonDown="Drag">
                <TextBlock Text="EdgeLocker · Reset" Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center" Margin="18,0,0,0"/>
                <Button HorizontalAlignment="Right" Width="36" Height="36" Click="Cancel_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="Transparent" CornerRadius="0,14,0,0">
                                <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{StaticResource Muted}" StrokeThickness="1.4"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Width="11" Height="11" Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#EF4444"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="28,4,28,24">
                <TextBlock Text="Reset master password" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                <TextBlock x:Name="StepTxt" Text="We'll email a 6-digit code to your Gmail."
                           Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,18"/>

                <Button x:Name="SendBtn" Content="Send code to my Gmail" Style="{StaticResource PrimaryButton}" Click="Send_Click" Margin="0,0,0,18"/>

                <TextBlock Text="6-DIGIT CODE" Style="{StaticResource Label}"/>
                <TextBox x:Name="OtpBox" Margin="0,0,0,12" IsEnabled="False"/>

                <TextBlock Text="NEW PASSWORD" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="NewPwd" Margin="0,0,0,12" IsEnabled="False"/>

                <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="NewPwd2" Margin="0,0,0,14" IsEnabled="False"/>

                <TextBlock x:Name="ErrorTxt" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button x:Name="ConfirmBtn" Content="Update password" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
