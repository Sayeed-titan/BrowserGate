<Window x:Class="BrowserGate.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrowserGate" Height="640" Width="540"
        Icon="pack://application:,,,/BrowserGate.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource UiFont}">
    <Border Background="{DynamicResource BgWin}" CornerRadius="14" Margin="18"
            BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" Opacity="0.55" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgTitlebar}"
                    BorderBrush="{DynamicResource BorderSub}" BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0">
                <Grid MouseLeftButtonDown="Drag">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Foreground="{DynamicResource FgHeading}" FontWeight="Bold" FontSize="11" Text="Browser"/>
                        <TextBlock Foreground="{DynamicResource FgMuted}" FontWeight="Bold" FontSize="11" Text="Gate"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource WinChromeBtn}" Click="Minimize_Click">
                            <Path Data="M 0,6 L 12,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource WinCloseBtn}" Click="Close_Click" Margin="2,0,0,0">
                            <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,18,26,22">
                <StackPanel>
                    <!-- ═══ Status hero ═══ -->
                    <Border x:Name="HeroCard" CornerRadius="12" Padding="18,16" Margin="0,0,0,16"
                            Background="{DynamicResource SafeBg}" BorderBrush="{DynamicResource SafeBorder}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" x:Name="HeroIcon" Width="52" Height="52" CornerRadius="14"
                                    Background="{DynamicResource Safe}" VerticalAlignment="Center">
                                <Path x:Name="HeroIconPath" Stretch="Uniform" Width="28" Height="28"
                                      Stroke="{DynamicResource SafeInk}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 12,3 L 21,7 V 12 C 21,17 17,21 12,22 C 7,21 3,17 3,12 V 7 Z M 8.5,12 L 11,14.5 L 16,9"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusTxt" Text="Protected" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource Safe}"/>
                                <TextBlock x:Name="StatusSub" Text="" FontSize="12.5" Margin="0,3,0,0"
                                           Foreground="{DynamicResource FgBody}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Ellipse Grid.Column="2" x:Name="HeroDot" Width="9" Height="9"
                                     Fill="{DynamicResource Safe}" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- ═══ Locked browsers ═══ -->
                    <TextBlock Text="LOCKED BROWSERS" Style="{StaticResource Lbl}" Margin="0,0,0,9"/>

                    <!-- Edge pick -->
                    <Border CornerRadius="10" Padding="12" Margin="0,0,0,9"
                            Background="{DynamicResource BgElev}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Background="{DynamicResource EdgeBg}">
                                <Path Stretch="Uniform" Width="18" Height="18" Stroke="{DynamicResource EdgeFg}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 12,3 A 9,9 0 1,1 3.5,15 C 7,16 11,15 14,12 C 17,9 18,5 17,2 A 9,9 0 0,1 12,3 Z"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="Microsoft Edge" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource FgHeading}"/>
                                <TextBlock x:Name="EdgeStatusTxt" Text="Locked" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource FgMuted}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" x:Name="LockEdgeChk" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="ApplyLocks_Click"/>
                        </Grid>
                    </Border>

                    <!-- Chrome pick -->
                    <Border CornerRadius="10" Padding="12" Margin="0,0,0,16"
                            Background="{DynamicResource BgElev}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Background="{DynamicResource ChromeBg}">
                                <Grid Width="18" Height="18">
                                    <Ellipse Stroke="{DynamicResource ChromeFg}" StrokeThickness="2"/>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource ChromeFg}"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="Google Chrome" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource FgHeading}"/>
                                <TextBlock x:Name="ChromeStatusTxt" Text="Locked" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource FgMuted}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" x:Name="LockChromeChk" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="ApplyLocks_Click"/>
                        </Grid>
                    </Border>

                    <!-- ═══ Auto re-lock + Theme ═══ -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="AUTO RE-LOCK AFTER" Style="{StaticResource Lbl}" Margin="0,0,0,9"/>
                            <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5"
                                    CornerRadius="10" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−" Style="{StaticResource StepperBtn}" Click="RelockDown_Click"/>
                                    <TextBlock x:Name="RelockVal" Text="5" VerticalAlignment="Center"
                                               MinWidth="52" TextAlignment="Center" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource FgHeading}"/>
                                    <TextBlock Text="min" VerticalAlignment="Center" Margin="0,0,13,0"
                                               FontSize="11" Foreground="{DynamicResource FgFaint}"/>
                                    <Button Content="+" Style="{StaticResource StepperBtn}" Click="RelockUp_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <TextBlock Text="THEME" Style="{StaticResource Lbl}" Margin="0,0,0,9"/>
                            <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5"
                                    CornerRadius="10">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeDark"  GroupName="Theme" Click="ThemeDark_Click"  Style="{StaticResource ThemeSegBtn}" Content="Dark"/>
                                    <RadioButton x:Name="ThemeLight" GroupName="Theme" Click="ThemeLight_Click" Style="{StaticResource ThemeSegBtn}" Content="Light"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ═══ Manage actions ═══ -->
                    <TextBlock Text="MANAGE" Style="{StaticResource Lbl}" Margin="0,0,0,9"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="9"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource BtnAction}" Click="Change_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 14,8 L 21,15 M 17,11 L 21,7 L 17,3 L 13,7 M 13,7 L 7,13 A 3,3 0 0,0 7,17 L 9,19 A 3,3 0 0,0 13,19 L 19,13"/>
                                <TextBlock Text="Change master password" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource BtnAction}" Click="Test_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource Accent}"
                                      Data="M 6,4 L 20,12 L 6,20 Z"/>
                                <TextBlock Text="Test launch" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource BtnAction}" Click="OpenFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 3,7 V 19 A 2,2 0 0,0 5,21 H 19 A 2,2 0 0,0 21,19 V 9 A 2,2 0 0,0 19,7 H 12 L 10,5 H 5 A 2,2 0 0,0 3,7 Z"/>
                                <TextBlock Text="Open config folder" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ═══ Danger zone ═══ -->
                    <Border BorderBrush="{DynamicResource BorderSub}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="DANGER ZONE" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource Danger}" FontFamily="{StaticResource UiFont}"/>
                                <TextBlock Text="Remove BrowserGate and stop locking browsers."
                                           FontSize="11.5" Margin="0,3,0,0" Foreground="{DynamicResource FgMuted}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource BtnDanger}" Click="Uninstall_Click" VerticalAlignment="Center" Padding="14,9">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 4,7 H 20 M 9,7 V 5 A 2,2 0 0,1 11,3 H 13 A 2,2 0 0,1 15,5 V 7 M 6,7 L 7,20 A 2,2 0 0,0 9,22 H 15 A 2,2 0 0,0 17,20 L 18,7"/>
                                    <TextBlock Text="Uninstall" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="MsgTxt" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgMuted}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
