<Window x:Class="BrowserGate.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrowserGate" Height="620" Width="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource UiFont}">
    <Border Background="{StaticResource Card}" CornerRadius="14" Margin="18"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" Opacity="0.55" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="40" MouseLeftButtonDown="Drag">
                <TextBlock Text="BrowserGate" Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="40" Height="40" Click="Minimize_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="Transparent">
                                    <Path Data="M 0,6 L 12,6" Stroke="{StaticResource Muted}" StrokeThickness="1.4"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Width="12" Height="12" Stretch="Uniform"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2A3252"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Width="40" Height="40" Click="Close_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="Transparent" CornerRadius="0,14,0,0">
                                    <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{StaticResource Muted}" StrokeThickness="1.4"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Width="11" Height="11" Stretch="Uniform"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#EF4444"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,4,32,24">
                <StackPanel>
                    <!-- Status hero -->
                    <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="20" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" x:Name="StatusIcon" Width="54" Height="54" CornerRadius="13" Background="{StaticResource Success}" VerticalAlignment="Center">
                                <Path Data="M 16,22 L 16,16 A 8,8 0 0 1 32,16 L 32,22 M 12,22 L 36,22 L 36,40 L 12,40 Z"
                                      Stroke="White" StrokeThickness="2.5" Fill="Transparent" Stretch="Uniform" Width="26" Height="26"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusTxt" Text="Loading..." FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatusSub" Text="" Style="{StaticResource Subtle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- What to lock -->
                    <TextBlock Text="Locked browsers" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="LockEdgeChk" Margin="0,0,0,10" Click="ApplyLocks_Click">
                        <TextBlock Text="Microsoft Edge"/>
                    </CheckBox>
                    <CheckBox x:Name="LockChromeChk" Margin="0,0,0,20" Click="ApplyLocks_Click">
                        <TextBlock Text="Google Chrome"/>
                    </CheckBox>

                    <!-- Auto-relock -->
                    <TextBlock Text="Auto-relock" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Text="Close browser N minutes after you stop using it. Set 0 to disable."
                               Style="{StaticResource Subtle}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <TextBox x:Name="RelockBox" Width="80" HorizontalAlignment="Left"/>
                        <TextBlock Text="minutes" VerticalAlignment="Center" Margin="10,0,10,0" Style="{StaticResource Subtle}"/>
                        <Button Content="Save" Style="{StaticResource GhostButton}" Click="SaveRelock_Click"/>
                    </StackPanel>

                    <!-- Actions -->
                    <TextBlock Text="Actions" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <Button Content="Change master password" Style="{StaticResource GhostButton}" Click="Change_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                    <Button Content="Test â€” open Edge now" Style="{StaticResource GhostButton}" Click="Test_Click" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                    <Button Content="Open config folder" Style="{StaticResource GhostButton}" Click="OpenFolder_Click" Margin="0,0,0,20" HorizontalAlignment="Stretch"/>

                    <Border Background="#3B0F12" CornerRadius="10" Padding="16" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Danger zone" FontWeight="SemiBold" Foreground="{StaticResource Danger}" Margin="0,0,0,8"/>
                            <Button Content="Uninstall BrowserGate" Style="{StaticResource DangerButton}" Click="Uninstall_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="MsgTxt" Margin="0,14,0,0" TextWrapping="Wrap" Style="{StaticResource Subtle}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
