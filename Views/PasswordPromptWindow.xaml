<Window x:Class="EdgeLocker.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EdgeLocker" Height="340" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" FontFamily="{StaticResource UiFont}">
    <Border Background="{StaticResource Card}" CornerRadius="14" Margin="18"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" Opacity="0.6" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="36" MouseLeftButtonDown="Drag">
                <TextBlock x:Name="HeaderTxt" Text="EdgeLocker" Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center" Margin="18,0,0,0"/>
                <Button HorizontalAlignment="Right" Width="36" Height="36" Click="Cancel_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="Transparent" CornerRadius="0,14,0,0">
                                <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{StaticResource Muted}" StrokeThickness="1.4"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Width="11" Height="11" Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#EF4444"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="28,4,28,24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource Accent}" VerticalAlignment="Center">
                        <Path Data="M 16,22 L 16,16 A 8,8 0 0 1 32,16 L 32,22 M 12,22 L 36,22 L 36,40 L 12,40 Z"
                              Stroke="White" StrokeThickness="2.5" Fill="Transparent" Stretch="Uniform" Width="22" Height="22"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock x:Name="TitleTxt" Text="Microsoft Edge is locked" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Enter master password to continue" Style="{StaticResource Subtle}"/>
                    </StackPanel>
                </StackPanel>

                <PasswordBox x:Name="PwdBox" Margin="0,0,0,8" KeyDown="PwdBox_KeyDown"/>
                <TextBlock x:Name="ErrorTxt" Foreground="{StaticResource Danger}" FontSize="12" Margin="2,0,0,10" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Forgot password" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Forgot_Click"/>
                    <Button Content="Unlock" Style="{StaticResource PrimaryButton}" Click="Unlock_Click" MinWidth="110"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
