<Window x:Class="BrowserGate.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrowserGate" Height="440" Width="440"
        Icon="pack://application:,,,/BrowserGate.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" FontFamily="{StaticResource UiFont}">
    <Border x:Name="Shell" Background="{DynamicResource BgWin}" CornerRadius="14" Margin="18"
            BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" Opacity="0.6" ShadowDepth="0"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="ShakeTx"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgTitlebar}"
                    BorderBrush="{DynamicResource BorderSub}" BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0">
                <Grid MouseLeftButtonDown="Drag">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Foreground="{DynamicResource FgHeading}" FontWeight="Bold" FontSize="11" Text="Browser"/>
                        <TextBlock Foreground="{DynamicResource FgMuted}" FontWeight="Bold" FontSize="11" Text="Gate"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Margin="0,0,7,0" VerticalAlignment="Center"
                            Style="{StaticResource WinCloseBtn}" Click="Cancel_Click">
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="32,0,32,24" HorizontalAlignment="Stretch">
                <!-- Brand padlock -->
                <Border Width="56" Height="56" CornerRadius="18"
                        Background="{DynamicResource AccentSoft}"
                        BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Path Stretch="Uniform" Width="28" Height="28"
                          Stroke="{DynamicResource Accent}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M 5,12 L 23,12 L 23,25 L 5,25 Z M 8.5,12 L 8.5,8 A 5.5,5.5 0 0 1 19.5,8 L 19.5,12"/>
                </Border>

                <TextBlock x:Name="TitleTxt" Text="Microsoft Edge is locked"
                           Style="{StaticResource HTitleSm}" HorizontalAlignment="Center"
                           Margin="0,15,0,0"/>
                <TextBlock Text="Enter your master password to continue"
                           Style="{StaticResource HSub}" HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>

                <PasswordBox x:Name="PwdBox" KeyDown="PwdBox_KeyDown" Margin="0,18,0,0"
                             FontSize="15" Padding="14,12"/>

                <Grid Margin="0,9,0,0">
                    <TextBlock x:Name="ErrorTxt" Foreground="{DynamicResource Danger}"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                </Grid>

                <Button Content="Unlock" Style="{StaticResource BtnPrimary}"
                        Click="Unlock_Click" Margin="0,12,0,0" Padding="16,13" FontSize="14"/>

                <Button Content="Forgot password" Style="{StaticResource BtnLink}"
                        Click="Forgot_Click" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
